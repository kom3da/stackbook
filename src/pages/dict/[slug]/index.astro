---
import NamePanel from '../../../components/NamePanel.astro';
import SecNav from '../../../components/SecNav.astro';
import SideNav from '../../../components/SideNav.astro';
import Base from '../../../layouts/Base.astro';
import { ToolBody } from '../../../components/ToolBody';
import { LINKS, toolView } from '../../../lib/view';
import { category, dictionary, type Tool } from '../../../lib/tools';

export function getStaticPaths() {
  return dictionary()
    .map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Tool };
---

<Base title={t.name} tab="dict" md={`/dict/${t.slug}.md`} app>
  <SideNav label="分野" rail={t.name}>
    <SecNav slot="nav" group="tools" current="" />
    <div class="sec-grid has-marg">
      <article class="paper">
        <header class="sec-top">
          <p class="sec-meta">ツール・{category(t)}</p>
          <span class="sec-acts pager">
            <button type="button" class="btn btn-primary" data-copy-md={`/dict/${t.slug}.md`}>Markdownでコピー</button>
            <button type="button" class="btn lg:hidden" aria-haspopup="dialog" data-sheet-open>分野</button>
          </span>
        </header>
        <h1 class="sec-h">{t.name}</h1>
        <div class="mt-8"><ToolBody tool={toolView(t)} links={LINKS} /></div>
      </article>
      <aside class="marg"><NamePanel /></aside>
    </div>
  </SideNav>
</Base>
