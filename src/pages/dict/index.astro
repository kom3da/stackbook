---
import Base from '../../layouts/Base.astro';
import { GROUPS, plain, SEC, stripNo } from '../../lib/guide';
import { secHref } from '../../lib/inline';
import { dictionary, hrefOf, ROWS, type Tool, TOOLS } from '../../lib/tools';

const summary = (t: Tool) => {
  if (t.lang) return `言語（§${t.lang.ref}）`;
  const def = [...new Set(t.def.map((r) => plain(r.role)))];
  if (def.length) return `既定：${def.slice(0, 3).join('、')}`;
  const alt = [...new Set(t.alt.map((a) => plain(a.row.role)))];
  if (alt.length) return `代替：${alt.slice(0, 3).join('、')}`;
  return t.uses.map((u) => plain(u.situation)).slice(0, 2).join('、');
};
const initial = (n: string) => (/^[a-z]/i.test(n) ? n[0].toUpperCase() : '#');
const tools = dictionary();
const groups = new Map<string, Tool[]>();
for (const t of tools) groups.set(initial(t.name), [...(groups.get(initial(t.name)) ?? []), t]);

// Field view: each §1–19 with its defaults (or its subsections for §2 and §19)
const fields = GROUPS.tools.flatMap((id) => {
  const s = SEC.get(id);
  if (!s) return [];
  const subs = id === '2' || id === '19';
  const items = subs
    ? s.blocks.flatMap((b) =>
        b.t === 'h3'
          ? [{ label: stripNo(plain(b.text)).replace(id === '2' ? /（.*$/ : /$^/, ''), href: secHref(id, b.id) }]
          : [],
      )
    : [...new Set(ROWS.filter((r) => r.sec === s).flatMap((r) => r.tools))].flatMap((id) => {
        const t = TOOLS.get(id);
        return t ? [{ label: t.name, href: hrefOf(t) }] : [];
      });
  return [{ s, items }];
});
---

<Base title="辞書" tab="dict" md="/dict.md" wide>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight">辞書</h1>
    <p class="lead mt-2">ガイドに出てくる言語・ライブラリ・サービス {tools.length} 件。どこで既定か、何に乗り換えるか、根拠と費用をまとめて引ける。</p>
  </header>

  <div class="sticky top-14 z-10 -mx-4 mt-8 flex items-center gap-3 border-b border-rule bg-bg/90 px-4 py-3 backdrop-blur-md sm:-mx-6 sm:px-6">
    <div role="tablist" aria-label="並べ方" class="flex shrink-0 rounded-lg border border-rule bg-surface p-0.5 text-sm">
      <button role="tab" id="t-fields" aria-controls="p-fields" aria-selected="true" class="seg">分野別</button>
      <button role="tab" id="t-name" aria-controls="p-name" aria-selected="false" class="seg">名前順</button>
    </div>
    <input
      id="df"
      type="search"
      placeholder="絞り込み"
      aria-label="辞書を名前で絞り込み"
      class="w-full max-w-sm min-w-0 rounded-lg border border-rule bg-surface px-3 py-1.5 text-sm placeholder:text-faint"
    />
  </div>
  <p id="dn" class="sr-only" aria-live="polite"></p>

  <div id="p-name" role="tabpanel" aria-labelledby="t-name" hidden class="mt-6">
    {
      [...groups].map(([letter, list]) => (
        <section data-letter class="mt-8 first:mt-0">
          <h2 class="font-mono text-sm text-faint">{letter}</h2>
          <ul class="mt-2 grid grid-cols-1 gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((t) => (
              <li data-k={`${t.name} ${summary(t)}`.toLowerCase()} class="border-b border-rule">
                <a
                  href={hrefOf(t)}
                  class="group flex min-w-0 items-baseline gap-3 py-2.5 no-underline"
                >
                  <span class="shrink-0 font-medium group-hover:text-accent">
                    {t.name}
                  </span>
                  <span class="min-w-0 truncate text-xs text-mute">{summary(t)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p id="dnone" hidden class="mt-6 text-mute">該当なし</p>
  </div>

  <div id="p-fields" role="tabpanel" aria-labelledby="t-fields" class="mt-6 grid gap-x-10 lg:grid-cols-2">
    {
      fields.map(({ s, items }) => (
        <section class="border-b border-rule py-4">
          <h2>
            <a href={secHref(s.id)} class="group flex items-baseline gap-2 no-underline">
              <span class="font-mono text-xs text-accent">§{s.num}</span>
              <span class="font-semibold group-hover:text-accent">{s.title}</span>
            </a>
          </h2>
          <p class="mt-1.5 text-sm leading-relaxed text-mute">
            {items.map((it, i) => (
              <>
                {i > 0 && <span class="text-faint"> · </span>}
                <a href={it.href} class="tl">
                  {it.label}
                </a>
              </>
            ))}
          </p>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .seg {
    border-radius: 0.4rem;
    padding: 0.25rem 0.75rem;
    color: var(--mute);
    cursor: pointer;
  }
  .seg[aria-selected="true"] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  const input = document.getElementById('df') as HTMLInputElement;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const live = document.getElementById('dn') as HTMLElement;

  function show(view: 'name' | 'fields') {
    for (const t of tabs) {
      const on = t.id === `t-${view}`;
      t.setAttribute('aria-selected', String(on));
      (document.getElementById(t.getAttribute('aria-controls') ?? '') as HTMLElement).hidden = !on;
    }
    history.replaceState(null, '', view === 'name' ? '#name' : location.pathname);
  }
  function filter() {
    const t = input.value.toLowerCase().trim();
    if (t) show('name');
    let total = 0;
    for (const sec of document.querySelectorAll<HTMLElement>('[data-letter]')) {
      let n = 0;
      for (const li of sec.querySelectorAll<HTMLElement>('li')) {
        const ok = !t || (li.dataset.k ?? '').includes(t);
        li.hidden = !ok;
        if (ok) n++;
      }
      sec.hidden = n === 0;
      total += n;
    }
    (document.getElementById('dnone') as HTMLElement).hidden = total > 0;
    live.textContent = t ? `${total}件` : '';
  }
  for (const t of tabs) t.addEventListener('click', () => show(t.id === 't-fields' ? 'fields' : 'name'));
  input.addEventListener('input', filter);
  if (location.hash === '#name') show('name');
</script>
