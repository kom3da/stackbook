---
import NamePanel from '../../components/NamePanel.astro';
import SecNav from '../../components/SecNav.astro';
import SideNav from '../../components/SideNav.astro';
import Base from '../../layouts/Base.astro';
import { GROUPS, plain, SEC, stripNo } from '../../lib/guide';
import { secHref } from '../../lib/inline';
import { dictionary, hrefOf, ROWS, TOOLS } from '../../lib/tools';

const tools = dictionary();

// Field view: each §1–19 with its defaults (or its subsections for §2 and §19)
const fields = GROUPS.tools.flatMap((id) => {
  const s = SEC.get(id);
  if (!s) return [];
  const subs = id === '2' || id === '19';
  const items = subs
    ? s.blocks.flatMap((b) =>
        b.t === 'h3'
          ? [{ label: stripNo(plain(b.text)).replace(id === '2' ? /（.*$/ : /$^/, ''), href: secHref(id, b.id) }]
          : [],
      )
    : [...new Set(ROWS.filter((r) => r.sec === s).flatMap((r) => r.tools))].flatMap((id) => {
        const t = TOOLS.get(id);
        return t ? [{ label: t.name, href: hrefOf(t) }] : [];
      });
  return [{ s, items }];
});
---

<Base title="辞書" tab="dict" md="/dict.md" app>
  <SideNav label="分野" rail="辞書">
    <SecNav slot="nav" group="tools" current="" />
    <div class="sec-grid has-marg">
      <article class="paper">
        <header class="sec-top">
          <p class="sec-meta">辞書　{tools.length}件・{fields.length}分野</p>
          <span class="sec-acts pager">
            <button type="button" class="btn btn-primary" data-copy-md="/dict.md">Markdownでコピー</button>
            <button type="button" class="btn lg:hidden" aria-haspopup="dialog" data-sheet-open>分野</button>
          </span>
        </header>
        <h1 class="sec-h">辞書</h1>
        <p class="mt-3 text-mute">ガイドに出てくる言語・ライブラリ・サービス。分野を選ぶと、その分野の既定・代替・乗り換える条件が表で読める。名前は右の欄で引ける。</p>
        <div class="dict-fields">
          {
            fields.map(({ s, items }) => (
              <section>
                <h2 class="pager">
                  <a href={secHref(s.id)} class="dict-f">
                    <span class="font-mono text-xs text-mute">§{s.num}</span>
                    {s.title}
                  </a>
                </h2>
                <p>
                  {items.map((it, i) => (
                    <>
                      {i > 0 && <span class="text-faint"> · </span>}
                      <a href={it.href} class="tl">
                        {it.label}
                      </a>
                    </>
                  ))}
                </p>
              </section>
            ))
          }
        </div>
      </article>
      <aside class="marg"><NamePanel /></aside>
    </div>
  </SideNav>
</Base>
