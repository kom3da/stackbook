---
import Base from '../../layouts/Base.astro';
import { plain } from '../../lib/guide';
import { category, dictionary, type Tool } from '../../lib/tools';

const summary = (t: Tool) => {
  if (t.lang) return `言語（§${t.lang.ref}）`;
  const def = [...new Set(t.def.map((r) => plain(r.role)))];
  if (def.length) return `既定：${def.slice(0, 3).join('、')}`;
  const alt = [...new Set(t.alt.map((a) => plain(a.row.role)))];
  if (alt.length) return `代替：${alt.slice(0, 3).join('、')}`;
  return t.uses.map((u) => plain(u.situation)).slice(0, 2).join('、');
};
const initial = (n: string) => (/^[a-z]/i.test(n) ? n[0].toUpperCase() : '#');
const tools = dictionary();
const groups = new Map<string, Tool[]>();
for (const t of tools) groups.set(initial(t.name), [...(groups.get(initial(t.name)) ?? []), t]);
const cats = [...new Set(tools.map(category))].sort((a, b) => (a === '言語' ? -1 : b === '言語' ? 1 : 0));
---

<Base title="辞書" tab="dict" md="/dict.md" wide>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight">辞書</h1>
    <p class="lead mt-2">ガイドに出てくる言語・ライブラリ・サービス {tools.length} 件。どこで既定か、何に乗り換えるか、根拠と費用をまとめて引ける。</p>
  </header>

  <div class="sticky top-14 z-10 -mx-4 mt-8 border-b border-rule bg-bg/90 px-4 py-3 backdrop-blur-md sm:-mx-6 sm:px-6">
    <input
      id="df"
      type="search"
      placeholder="絞り込み"
      aria-label="辞書を絞り込み"
      class="w-full max-w-sm rounded-lg border border-rule bg-surface px-3 py-1.5 text-sm placeholder:text-faint"
    />
    <div class="chips mt-3" id="dc" role="group" aria-label="分類">
      <label><input type="radio" name="cat" value="" checked /><span>すべて</span></label>
      {
        cats.map((c) => (
          <label>
            <input type="radio" name="cat" value={c} />
            <span>{c}</span>
          </label>
        ))
      }
    </div>
  </div>

  <div id="dl" class="mt-6">
    {
      [...groups].map(([letter, list]) => (
        <section data-letter class="mt-8 first:mt-0">
          <h2 class="font-mono text-sm text-faint">{letter}</h2>
          <ul class="mt-2 grid grid-cols-1 gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((t) => (
              <li data-k={`${t.name} ${summary(t)}`.toLowerCase()} data-c={category(t)} class="border-b border-rule">
                <a href={`/dict/${t.slug}/`} class="group flex min-w-0 items-baseline gap-3 py-2.5 no-underline">
                  <span class="shrink-0 font-medium group-hover:text-accent">{t.name}</span>
                  <span class="min-w-0 truncate text-xs text-mute">{summary(t)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p id="dn" hidden class="mt-6 text-mute">該当なし</p>
</Base>

<script>
  const input = document.getElementById('df') as HTMLInputElement;
  const chips = document.getElementById('dc') as HTMLElement;
  function apply() {
    const t = input.value.toLowerCase().trim();
    const c = (chips.querySelector('input:checked') as HTMLInputElement | null)?.value ?? '';
    let any = false;
    for (const sec of document.querySelectorAll<HTMLElement>('[data-letter]')) {
      let n = 0;
      for (const li of sec.querySelectorAll<HTMLElement>('li')) {
        const ok = (!t || (li.dataset.k ?? '').includes(t)) && (!c || li.dataset.c === c);
        li.hidden = !ok;
        if (ok) n++;
      }
      sec.hidden = n === 0;
      any ||= n > 0;
    }
    (document.getElementById('dn') as HTMLElement).hidden = any;
  }
  input.addEventListener('input', apply);
  chips.addEventListener('change', apply);
</script>
