---
import Base from '../../../layouts/Base.astro';
import CasePick from '../../../components/CasePick.astro';
import KitMarg from '../../../components/KitMarg.astro';
import NamePanel from '../../../components/NamePanel.astro';
import SecNav from '../../../components/SecNav.astro';
import SideNav from '../../../components/SideNav.astro';
import { headText, GROUP_LABEL, GROUPS, isStale, STALE_MONTHS, SECS, groupOf, guide, type Section, secLabel } from '../../../lib/guide';
import { Blocks } from '../../../components/Blocks';
import { LINKS } from '../../../lib/view';

export function getStaticPaths() {
  return guide.sections.map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: Section };
const g = groupOf(s.id);
const list = GROUPS[g] as readonly string[];
const i = list.indexOf(s.id);
const bySec = (id?: string) => guide.sections.find((x) => x.id === id);
const prev = bySec(list[i - 1]);
const next = bySec(list[i + 1]);
const h3 = s.blocks.filter((b) => b.t === 'h3');
const tab = g === 'tools' ? 'dict' : g;
const meta = g === 'read' ? `${GROUP_LABEL[g]}　${i + 1} / ${list.length}` : GROUP_LABEL[g];
---

<Base title={secLabel(s)} tab={tab} md={`/s/${s.id}.md`} app>
  <SideNav label={GROUP_LABEL[g]} rail={secLabel(s)}>
    <SecNav slot="nav" group={g} current={s.id} />
    <div class:list={['sec-grid', (g === 'kit' || g === 'tools') && 'has-marg']}>
    <article class="paper">
    <header class="sec-top">
      <p class="sec-meta">{meta}{s.checked && `　確認：${s.checked}`}</p>
      <span class="sec-acts pager">
        {g === 'read' && prev && <a class="btn btn-s max-sm:hidden" href={`/s/${prev.id}/`}>‹ {secLabel(prev)}</a>}
        {g === 'read' && next && <a class="btn btn-s max-sm:hidden" href={`/s/${next.id}/`}>{secLabel(next)} ›</a>}
        {s.id === SECS.checklist && <button type="button" class="btn" data-ck-clear={s.id}>チェックをすべて外す</button>}
        <button type="button" class="btn btn-primary" data-copy-md={`/s/${s.id}.md`}><span class="max-sm:sr-only">Markdownで</span>コピー</button>
        <button type="button" class="btn lg:hidden" aria-haspopup="dialog" data-sheet-open>目次</button>
      </span>
    </header>
    <h1 class="sec-h">{s.title}</h1>
    {g === 'kit' && <CasePick />}
    {isStale(s) && <p class="warn">{STALE_MONTHS}か月以上見直していない。内容が古くなっている可能性がある。</p>}
    {
      h3.length >= 3 && (
        <nav aria-label="このページの見出し" class="mt-6 flex flex-wrap gap-1.5 lg:hidden">
          {h3.map((b) => (
            <a href={`#${b.t === 'h3' ? b.id : ''}`} class="nx">
              {b.t === 'h3' && headText(b.text)}
            </a>
          ))}
        </nav>
      )
    }
    <div class="doc mt-10"><Blocks blocks={s.blocks} secId={s.id} links={LINKS} /></div>
    {
      s.id === SECS.prof && (
        <div class="prof-io">
          <button type="button" data-a="exp">書き出し</button>
          <button type="button" data-a="imp">読み込み</button>
          <button type="button" data-a="clr">すべてクリア</button>
          <textarea aria-label="習熟度のJSON" placeholder="書き出したJSONがここに表示される。読み込むときはここに貼り付ける" />
        </div>
      )
    }
    <nav class="pager mt-16 grid gap-3 border-t border-rule pt-6 sm:grid-cols-2">
      {
        prev ? (
          <a href={`/s/${prev.id}/`} class="rounded-xl border border-rule p-4 no-underline hover:border-accent">
            <span class="block text-xs text-mute">前</span>
            {secLabel(prev)}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/s/${next.id}/`} class="rounded-xl border border-rule p-4 text-right no-underline hover:border-accent">
            <span class="block text-xs text-mute">次</span>
            {secLabel(next)}
          </a>
        )
      }
    </nav>
    </article>
    {g === 'tools' && <aside class="marg"><NamePanel field={s.id} /></aside>}
    {g === 'kit' && <KitMarg sec={s.id} />}
    </div>
  </SideNav>
</Base>
