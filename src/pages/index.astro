---
import Base from '../layouts/Base.astro';
import { guide } from '../lib/guide';
import { inline } from '../lib/html';
import { KINDS } from '../lib/wizard';

const doors = [
  ['/dict/', '辞書', '言語・ライブラリを名前から引く'],
  ['/fields/', '分野', '分野ごとの既定と、乗り換える条件'],
  ['/read/', '考え方', '原則・根拠・目安の数値・費用'],
  ['/kit/', '手元', 'チェックリスト・コマンド・習熟度'],
];
---

<Base tab="make" md="/llms.txt" wide>
  <header class="max-w-2xl">
    <p class="eyebrow">{guide.title}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">何を作る？</h1>
    <p class="lead mt-4">選ぶと、使う技術の一覧と理由、構成図、最初のコマンドが1画面にまとまる。</p>
  </header>

  <div class="mt-10 grid grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-3 lg:grid-cols-4">
    {
      KINDS.map(([k, name, desc]) => (
        <a
          href={`/make/${k}/`}
          class="group flex flex-col rounded-xl border border-rule bg-surface p-4 no-underline transition hover:-translate-y-px hover:border-accent sm:p-5"
        >
          <span class="font-semibold leading-snug group-hover:text-accent">{name}</span>
          <span class="mt-1 text-xs leading-relaxed text-mute sm:text-sm">{desc}</span>
        </a>
      ))
    }
  </div>

  <div class="mt-14 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
    {
      doors.map(([href, name, desc]) => (
        <a href={href} class="rounded-xl border border-dashed border-rule p-4 no-underline hover:border-accent">
          <span class="block font-semibold">{name} →</span>
          <span class="mt-0.5 block text-sm text-mute">{desc}</span>
        </a>
      ))
    }
  </div>

  <footer class="mt-16 space-y-0.5 border-t border-rule pt-6 text-xs text-faint">
    {guide.meta.map((m) => <p set:html={inline(m)} />)}
    <p>AIエージェント向け：<a class="ref" href="/llms.txt">/llms.txt</a></p>
  </footer>
</Base>
