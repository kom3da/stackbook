---
import { Inline, LinksContext } from '../components/Inline';
import KindNav from '../components/KindNav.astro';
import SideNav from '../components/SideNav.astro';
import Base from '../layouts/Base.astro';
import { GROUPS, guide, SEC, secLabel } from '../lib/guide';
import { LOOKUP } from '../lib/lookup';
import { dictionary, TOOLS } from '../lib/tools';
import { LINKS } from '../lib/view';
import { DEFAULTS, decide, KIND_GROUPS, KINDS, resolve } from '../lib/wizard';

// Each kind's answer under the default conditions, previewed in the marginalia before opening it
const previews = KIND_GROUPS.flatMap(([, ids]) => ids).map((k) => {
  const d = decide(k, DEFAULTS);
  const rows = d.tables.flatMap((t) => resolve(t, LOOKUP));
  return {
    k,
    name: KINDS.find((x) => x[0] === k)?.[1] ?? k,
    title: d.title,
    why: d.why[0] ?? '',
    rows: rows.slice(0, 6).map((r) => ({
      ...r,
      ops: [...new Set(r.tools.map((id) => TOOLS.get(id)?.ops).filter(Boolean))] as string[],
    })),
    more: rows.slice(6).map((r) => r.layer),
  };
});
const doors = [
  { href: '/dict/', name: '辞書', note: `${dictionary().length}件・${GROUPS.tools.length}分野`, text: '名前から、既定・代替・根拠・費用を引く。', ids: ['3', '4', '6'] },
  { href: '/read/', name: '考え方', note: `${GROUPS.read.length}章`, text: '選び方の根拠、成長したときの移り方、費用の見方を読む。', ids: ['20', '22', '23'] },
  { href: '/kit/', name: '準備', note: `${GROUPS.kit.length}章`, text: '案件を始めるときのチェックリスト、雛形のコマンド、習熟度の記録。', ids: ['21', '26', '27'] },
];
const OPS = { code: '自分で書く', self: '自分で運用する', managed: 'マネージドに任せる' } as Record<string, string>;
---

<Base tab="make" md="/llms.txt" app>
  <SideNav label="作るもの" rail="作るもの">
    <KindNav slot="nav" toc={false} />
    <div class="sec-grid has-marg">
      <article class="paper">
        <header class="sec-top">
          <p class="sec-meta">{guide.title}</p>
          <p class="sec-meta">{guide.meta.find((m) => m.startsWith('作成')) ?? ''}</p>
        </header>
        <h1 class="sec-h">作るものを選ぶと、言語と構成が決まる</h1>
        <p class="mt-3 text-mute">
          各カテゴリの「既定」は1つだけ。代替には乗り換える条件が付いている。バージョン番号と料金は書いていないので、採用時に最新を確認する。
        </p>

        <section class="home-last" id="home-last" hidden aria-labelledby="home-last-h">
          <p class="marg-k" id="home-last-h">前回の続き</p>
          <p class="home-last-t"><span data-last="name"></span>　→　<span data-last="title"></span></p>
          <p class="text-sm text-mute" data-last="summary"></p>
          <p class="mt-3 flex flex-wrap gap-2 pager"><a class="btn btn-primary" data-last="url" href="/">続きから開く</a></p>
        </section>

        <h2 class="home-h">作るもの　{KINDS.length}</h2>
        <ul class="home-kinds">
          {
            previews.map((p) => {
              const [, , desc] = KINDS.find((x) => x[0] === p.k) as (typeof KINDS)[number];
              return (
                <li>
                  <a href={`/make/${p.k}/`} data-kind={p.k} data-astro-prefetch>
                    <span class="hk-n">{p.name}</span>
                    <span class="hk-d">{desc}</span>
                    <span class="hk-t">{p.title}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="home-doors">
          {
            doors.map((d) => (
              <section>
                <h2 class="home-door-h pager">
                  <a href={d.href}>{d.name}</a>
                  <span class="text-xs font-normal text-mute">{d.note}</span>
                </h2>
                {d.text && <p class="mt-2 text-sm text-mute">{d.text}</p>}
                <ul>
                  {d.ids.map((id) => {
                    const s = SEC.get(id);
                    return s && <li><a class="ref" href={`/s/${id}/`}>{secLabel(s)}</a></li>;
                  })}
                </ul>
              </section>
            ))
          }
        </div>
        <p class="mt-10 text-xs text-mute">AIエージェント向け：<a class="ref" href="/llms.txt">/llms.txt</a></p>
      </article>

      <aside class="marg max-xl:hidden" aria-label="下見">
        <LinksContext.Provider value={LINKS}>
          {
            previews.map((p) => (
              <section class="home-pv" data-preview={p.k} hidden>
                <p class="text-xs text-mute">既定の条件で判定すると</p>
                <p class="mt-1 font-semibold">{p.name}</p>
                <p class="home-pv-t">{p.title}</p>
                {p.why && <p class="text-sm"><Inline text={p.why} /></p>}
                <table class="home-pv-rows">
                  <tbody>
                    {p.rows.map((r) => (
                      <tr class:list={[r.edited && 'st-ed']}>
                        <th scope="row">{r.layer}</th>
                        <td><Inline text={r.text} /></td>
                        <td class="text-right whitespace-nowrap">
                          {r.ops.map((o) => <span class={`om om-${o}`} role="img" aria-label={OPS[o]} />)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {p.more.length > 0 && <p class="mt-2 text-xs text-mute">ほか {p.more.join('・')} の{p.more.length}行</p>}
                <p class="mt-3 pager"><a class="btn btn-primary" href={`/make/${p.k}/`}>条件を選んで開く</a></p>
              </section>
            ))
          }
        </LinksContext.Provider>
        <div class="marg-b">
          <p class="marg-k">引き方</p>
          <p class="text-sm">上の検索に「pg-boss」や「認証」と打つと、この欄に開く。<kbd>/</kbd> でどの画面からでも検索へ。</p>
        </div>
        <div class="marg-b">
          <p class="marg-k">記号</p>
          <ul class="legend-list">
            {Object.entries(OPS).map(([o, l]) => <li><span class={`om om-${o}`} aria-hidden="true" />{l}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </SideNav>
</Base>

<script>
  // First press previews in the marginalia (when it is shown); the second opens the kind
  const wide = matchMedia('(min-width: 1280px)');
  // Start from the kind the reader last worked on
  if (wide.matches) {
    let k = 'web';
    try {
      k = JSON.parse(localStorage.getItem('stackbook:last') || 'null')?.kind ?? k;
    } catch {}
    const p = document.querySelector<HTMLElement>(`[data-preview="${CSS.escape(k)}"]`);
    if (p) p.hidden = false;
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-kind]');
    if (!a || !wide.matches || e.metaKey || e.ctrlKey || e.shiftKey) return;
    if (a.getAttribute('aria-current') === 'true') return;
    e.preventDefault();
    for (const x of document.querySelectorAll('a[data-kind]')) x.setAttribute('aria-current', String(x === a));
    for (const p of document.querySelectorAll<HTMLElement>('[data-preview]')) p.hidden = p.dataset.preview !== a.dataset.kind;
  });
  // 前回たどった順: the last chain of references, reopened as it was
  try {
    const t = JSON.parse(localStorage.getItem('stackbook:trail') || 'null');
    if (t?.url && t.labels?.length)
      for (const nav of document.querySelectorAll('.side-nav')) {
        const box = document.createElement('div');
        box.className = 'mt-9';
        const head = document.createElement('p');
        head.className = 'side-g';
        head.textContent = '前回たどった順';
        const a = document.createElement('a');
        a.href = t.url;
        a.className = 'side-trail';
        const ol = document.createElement('ol');
        ol.className = 'side-toc';
        for (const [i, l] of [t.page, ...t.labels].entries()) {
          const li = document.createElement('li');
          li.innerHTML = `<span class="side-toc-n">${i + 1}</span>`;
          li.append(String(l));
          ol.append(li);
        }
        a.append(ol);
        const note = document.createElement('p');
        note.className = 'side-note';
        note.textContent = '押すと、その状態のまま開く（このブラウザに保存）。';
        box.append(head, a, note);
        nav.append(box);
      }
  } catch {}
  // 前回の続き: the make page records where the reader left off
  try {
    const last = JSON.parse(localStorage.getItem('stackbook:last') || 'null');
    const box = document.getElementById('home-last');
    if (last && box) {
      const name = document.querySelector(`a[data-kind="${CSS.escape(last.kind)}"] .hk-n`)?.textContent ?? '';
      for (const el of box.querySelectorAll<HTMLElement>('[data-last]')) {
        const k = el.dataset.last as string;
        if (k === 'url') (el as HTMLAnchorElement).href = last.url;
        else el.textContent = k === 'name' ? name : (last[k] ?? '');
      }
      box.hidden = false;
    }
  } catch {}
</script>
