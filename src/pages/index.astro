---
import Base from '../layouts/Base.astro';
import { guide } from '../lib/guide';
import { Inline } from '../components/Inline';
import { DEFAULTS, decide, KINDS, type Kind } from '../lib/wizard';

// Grouped so a reader can skip straight to their kind of product
const GROUPS: [string, Kind[]][] = [
  ['Webサービス', ['web', 'saas', 'toc', 'ai', 'rt', 'ec', 'site']],
  ['ソフトウェア・ツール', ['cli', 'devtool', 'desktop', 'embedded']],
  ['データ', ['data']],
];
const doors = [
  ['/dict/', '辞書', '言語・ライブラリを名前や分野から引く'],
  ['/read/', '考え方', '原則・根拠・目安の数値・費用'],
  ['/kit/', '準備', 'チェックリスト・コマンド・習熟度'],
];
---

<Base tab="make" md="/llms.txt" wide>
  <header class="max-w-2xl">
    <p class="eyebrow">{guide.title}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">何を作る？</h1>
    <p class="lead mt-4">選ぶと、使う技術の一覧と理由、構成図、最初のコマンドが1画面にまとまる。</p>
  </header>

  <div class="mt-10 grid gap-x-12 gap-y-10 lg:grid-cols-2">
    {
      GROUPS.map(([label, ids]) => (
        <section>
          <h2 class="text-xs font-semibold tracking-wider text-faint">{label}</h2>
          <ul class="mt-2 border-t border-rule">
            {ids.map((k) => {
              const [, name, desc] = KINDS.find((x) => x[0] === k) as (typeof KINDS)[number];
              return (
                <li class="border-b border-rule">
                  <a href={`/make/${k}/`} class="group flex items-center gap-4 py-3.5 no-underline">
                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold group-hover:text-accent">{name}</span>
                      <span class="block text-sm text-mute">{desc}</span>
                      <span class="mt-1.5 inline-block rounded-md bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">
                        {decide(k, DEFAULTS).title}
                      </span>
                    </span>
                    <span aria-hidden="true" class="text-faint group-hover:text-accent">
                      ›
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>

  <div class="mt-14 hidden gap-2.5 md:grid md:grid-cols-3">
    {
      doors.map(([href, name, desc]) => (
        <a href={href} class="rounded-xl border border-dashed border-rule p-4 no-underline hover:border-accent">
          <span class="block font-semibold">{name} →</span>
          <span class="mt-0.5 block text-sm text-mute">{desc}</span>
        </a>
      ))
    }
  </div>

  <footer class="mt-16 space-y-0.5 border-t border-rule pt-6 text-xs text-faint">
    {
      guide.meta.map((m) => (
        <p>
          <Inline text={m} />
        </p>
      ))
    }
    <p>AIエージェント向け：<a class="ref" href="/llms.txt">/llms.txt</a></p>
  </footer>
</Base>
