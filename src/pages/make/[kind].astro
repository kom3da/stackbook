---
import KindNav from '../../components/KindNav.astro';
import MakeApp from '../../components/MakeApp';
import SideNav from '../../components/SideNav.astro';
import Base from '../../layouts/Base.astro';
import { makePayload } from '../../lib/make-data';
import { KINDS, type Kind } from '../../lib/wizard';

export function getStaticPaths() {
  return KINDS.map(([kind, name]) => ({ params: { kind }, props: { name } }));
}
const kind = Astro.params.kind as Kind;
const { name } = Astro.props;
---

<Base title={name} tab="make" md={`/make/${kind}.md`} app bar>
  <SideNav label="作るもの" rail={name}>
    <KindNav slot="nav" current={kind} />
    <MakeApp client:load kind={kind} payload={makePayload(kind)} />
  </SideNav>
</Base>
