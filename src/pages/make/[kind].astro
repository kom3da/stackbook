---
import KindNav from '../../components/KindNav.astro';
import MakeApp from '../../components/MakeApp';
import SideNav from '../../components/SideNav.astro';
import Base from '../../layouts/Base.astro';
import { makePayload } from '../../lib/make-data';
import { KINDS, type Kind } from '../../lib/wizard';

export function getStaticPaths() {
  return KINDS.map(([kind, name, desc]) => ({ params: { kind }, props: { name, desc } }));
}
const kind = Astro.params.kind as Kind;
const { name, desc } = Astro.props;
---

<Base title={name} tab="make" md={`/make/${kind}.md`} wide>
  <SideNav label="作るもの">
    <KindNav slot="nav" current={kind} />
    <header class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">{name}</h1>
        <p class="lead mt-1">{desc}</p>
      </div>
      <button type="button" class="side-btn lg:hidden" aria-haspopup="dialog" data-sheet-open>ほかを選ぶ</button>
    </header>
    <MakeApp client:load kind={kind} payload={makePayload(kind)} />
  </SideNav>
</Base>
