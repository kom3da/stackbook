---
// The page's index: a full-height column on desktop (a thin rail while a reference is open), a sheet on phones.
// Open the sheet with any button carrying data-sheet-open.
interface Props {
  label: string;
  /** Shown vertically on the rail */
  rail: string;
}
const { label, rail } = Astro.props;
const nav = await Astro.slots.render('nav');
---

<div class="app-grid">
  <aside class="app-side">
    <nav aria-label={label} class="side-nav" set:html={nav} />
    <div class="app-rail">
      <button type="button" class="rail-btn" aria-label={`${label}を開く`} aria-haspopup="dialog" data-sheet-open>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
      <span class="rail-l">{rail}</span>
    </div>
  </aside>
  <div class="app-body"><slot /></div>
</div>
<dialog id="side-sheet" class="peek" aria-label={label} tabindex="-1">
  <div class="peek-top">
    <span class="flex-1 text-sm font-semibold">{label}</span>
    <button type="button" class="peek-btn" data-sheet-close>閉じる</button>
  </div>
  <nav aria-label={label} class="side-nav min-h-0 flex-1 overflow-y-auto overscroll-contain px-6 pt-5 pb-8" set:html={nav} />
</dialog>

<script>
  const d = document.getElementById('side-sheet') as HTMLDialogElement;
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-sheet-open]')) {
      d.showModal();
      // Focus the sheet itself, not its close button, so the first thing seen isn't a focus ring on 閉じる
      d.focus();
    }
    // Close on the backdrop, the close button and in-page anchors
    else if (d.open && (t === d || t.closest('[data-sheet-close]') || t.closest('#side-sheet a[href^="#"]'))) d.close();
  });
</script>
