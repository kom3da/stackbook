---
import { backlinks } from '../lib/backlinks';
import { secHref } from '../lib/inline';
import { checkTotal, commandTotal, profNames, profTotal } from '../lib/kit';
import CasePick from './CasePick.astro';
import { headText, TITLES, GROUP_LABEL, GROUPS, SECS, type Group, guide, secLabel } from '../lib/guide';

interface Props {
  group: Group;
  current: string;
}
const { group, current } = Astro.props;
const secs = GROUPS[group].flatMap((id) => guide.sections.filter((s) => s.id === id));
// Reading chapters list where the rest of the guide points at them
const refs = group === 'read' ? backlinks(current) : [];
// Sections without a number (the introduction, the notes) go by their title
const secNum = (id: string) => {
  const s = guide.sections.find((x) => x.id === id);
  return s?.num ? s.num : (s?.title ?? id);
};
// The kit shows progress beside each tool, filled in from this browser's saved state
const counts: Record<string, { attrs: Record<string, string>; text: string }> = {
  [SECS.checklist]: { attrs: { 'data-count': 'check', 'data-sec': SECS.checklist, 'data-total': String(checkTotal()) }, text: '' },
  [SECS.commands]: { attrs: {}, text: String(commandTotal()) },
  [SECS.prof]: {
    attrs: { 'data-count': 'prof', 'data-total': String(profTotal()), 'data-names': JSON.stringify(profNames()) },
    text: '',
  },
};
---

<p class="side-g">{GROUP_LABEL[group]}</p>
<ul>
  {
    secs.map((s) => (
      <li>
        <a href={`/s/${s.id}/`} data-astro-prefetch aria-current={s.id === current ? 'page' : undefined} class={group === 'kit' ? 'side-kind' : undefined}>
          <span class="side-n">{secLabel(s)}</span>
          {group === 'kit' && counts[s.id] && <span class="side-d" {...counts[s.id].attrs}>{counts[s.id].text}</span>}
        </a>
        {s.id === current && (
          <ul class="side-sub">
            {s.blocks.flatMap((b) =>
              b.t === 'h3' ? [
                <li>
                  <a href={`#${b.id}`}>{headText(b.text)}</a>
                </li>,
              ] : [],
            )}
          </ul>
        )}
      </li>
    ))
  }
</ul>
{
  group === 'kit' && (
    <>
      <div class="mt-9"><CasePick /></div>
      <p class="side-note">選ぶと、このケースの雛形コマンドと、使うツールの習熟度が傍注に出る。</p>
      <p class="side-g mt-9">保存</p>
      <p class="side-note">チェックと習熟度はこのブラウザに保存する。習熟度表は JSON で書き出し・読み込みができる。</p>
    </>
  )
}
{
  refs.length > 0 && (
    <div class="backlinks">
      <p class="side-g mt-9">この章を参照している箇所</p>
      <ul>
        {refs.slice(0, 12).map((r) => (
          <li>
            <a href={secHref(r.fromSec, r.fromSub, r.step)}>
              {TITLES[r.fromSub ?? r.fromSec] ?? secNum(r.fromSec)}
              {r.step && ` 手順${r.step}`}
            </a>
            <span class="side-d"> → {TITLES[r.target] ?? r.target}</span>
          </li>
        ))}
      </ul>
      <p class="side-note">押すと参照の欄に開く。この本文は動かない。</p>
    </div>
  )
}
