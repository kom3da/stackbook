---
import { DEFAULTS, decide, KIND_GROUPS, KINDS, type Kind } from '../lib/wizard';

interface Props {
  current?: Kind;
  /** The make page's own contents; the home page has none */
  toc?: boolean;
}
const { current, toc = true } = Astro.props;
// Short forms of the default picks, to fit beside the names
const SHORT: Record<string, string> = {
  'Ruby / Rails': 'Rails',
  TypeScript: 'TS',
  'Shopify または Medusa': 'Shopify',
  'Astro＋ヘッドレスCMS': 'Astro',
  'SQL＋Python（Polars）': 'SQL＋Py',
  'React Native＋Expo': 'Expo',
};
const ids = KIND_GROUPS.flatMap(([, k]) => k);
const TOC = ['推奨言語', '構成', '構成図', '運用の内訳', '条件が違うとき', '作り始める', '次に読む'];
---

<p class="side-g">作るもの</p>
<ul>
  {
    ids.map((k) => {
      const [, name] = KINDS.find((x) => x[0] === k) as (typeof KINDS)[number];
      const def = decide(k, DEFAULTS).title;
      return (
        <li>
          <a href={`/make/${k}/`} data-astro-prefetch aria-current={k === current ? 'page' : undefined} class="side-kind">
            <span>{name}</span>
            <span class="side-d" title={def}>
              {SHORT[def] ?? def}
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
{
  toc && (
    <>
<p class="side-g mt-9">このメモの目次</p>
<ol class="side-toc">
  {
    TOC.map((t, i) => (
      <li>
        <a href={`#m${i + 1}`}>{t}</a>
      </li>
    ))
  }
</ol>
    </>
  )
}
<div class="side-tabs lg:hidden">
  <p class="side-g mt-9">ほかの画面</p>
  <ul>
    <li><a href="/dict/">辞書</a></li>
    <li><a href="/read/">考え方</a></li>
    <li><a href="/kit/">準備</a></li>
  </ul>
</div>
