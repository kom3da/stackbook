---
import { DEFAULTS, decide, KIND_GROUPS, KINDS, type Kind } from '../lib/wizard';

interface Props {
  current: Kind;
}
const { current } = Astro.props;
---

{
  KIND_GROUPS.map(([label, ids]) => (
    <section>
      <h2 class="side-g">{label}</h2>
      <ul>
        {ids.map((k) => {
          const [, name] = KINDS.find((x) => x[0] === k) as (typeof KINDS)[number];
          return (
            <li>
              <a href={`/make/${k}/`} data-astro-prefetch aria-current={k === current ? 'page' : undefined}>
                <span class="side-n">{name}</span>
                <span class="side-d">{decide(k, DEFAULTS).title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))
}
