---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { guide } from '../lib/guide';

interface Props {
  title?: string;
  tab?: 'make' | 'dict' | 'read' | 'kit';
  /** Markdown version of this page for AI agents */
  md?: string;
  /** Full-width app layout: side index, paper, marginalia (make and guide pages) */
  app?: boolean;
  /** The page brings its own bottom bar on phones */
  bar?: boolean;
}
const { title, tab, md, app = false, bar = false } = Astro.props;
const tabs = [
  ['make', '/', '作る'],
  ['dict', '/dict/', '辞書'],
  ['read', '/read/', '考え方'],
  ['kit', '/kit/', '準備'],
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} – ${guide.title}` : guide.title}</title>
    <meta name="description" content="ケース別の技術スタック・周辺ツール選定ガイド" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {md && <link rel="alternate" type="text/markdown" href={md} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@400;500;600;700&family=Schibsted+Grotesk:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={['min-h-dvh pb-20 md:pb-0', app && 'app']}>
    <header class="sticky top-0 z-20 border-b border-rule bg-bg">
      <div class:list={['flex h-14 items-center gap-6 px-4 sm:px-8', !app && 'mx-auto max-w-6xl sm:px-6']}>
        <Logo />
        <nav aria-label="主要" class="hidden gap-5 md:flex">
          {
            tabs.map(([k, href, label]) => (
              <a
                href={href}
                aria-current={tab === k ? 'page' : undefined}
                class="border-b-2 border-transparent py-[15px] text-sm text-mute no-underline hover:text-ink aria-[current]:border-ink aria-[current]:font-semibold aria-[current]:text-ink"
              >
                {label}
              </a>
            ))
          }
        </nav>
        <div class="search relative ml-auto w-full max-w-96">
          <svg class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-mute" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
          <input
            id="q"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="qres"
            placeholder="ツール・章を引く"
            aria-label="ツール名・章の名前で引く"
            autocomplete="off"
            class="h-9 w-full rounded-md border border-rule bg-surface pr-3 pl-9 text-sm sm:pr-9 placeholder:text-faint"
          />
          <kbd class="pointer-events-none absolute top-1/2 right-2 hidden -translate-y-1/2 rounded border border-rule px-1.5 font-mono text-[0.7rem] text-faint sm:block">/</kbd>
          <div
            id="qres"
            role="listbox"
            aria-label="検索結果"
            hidden
            class="absolute top-full right-0 mt-2 max-h-[70vh] w-[min(24rem,calc(100vw-2rem))] overflow-y-auto rounded-xl border border-rule bg-surface p-1.5 shadow-lg"
          >
          </div>
          <p id="qstat" class="sr-only" aria-live="polite"></p>
        </div>
      </div>
    </header>
    <nav
      aria-label="主要"
      class:list={['fixed inset-x-0 bottom-0 z-20 flex border-t border-rule bg-bg pb-[env(safe-area-inset-bottom)] md:hidden', bar && 'hidden']}
    >
      {
        tabs.map(([k, href, label]) => (
          <a
            href={href}
            aria-current={tab === k ? 'page' : undefined}
            class="flex-1 py-3 text-center text-sm text-mute no-underline aria-[current]:font-semibold aria-[current]:text-accent"
          >
            {label}
          </a>
        ))
      }
    </nav>
    <main id="main" class:list={app ? 'app-main' : 'mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12'}>
      <slot />
    </main>
    <dialog id="zoom" class="zoom" aria-label="構成図の拡大">
      <div class="peek-top">
        <span class="flex-1 text-sm font-semibold">構成図</span>
        <button type="button" class="peek-btn" data-z="out" aria-label="縮小">−</button>
        <button type="button" class="peek-btn" data-z="in" aria-label="拡大">＋</button>
        <button type="button" class="peek-btn" data-z="fit">全体</button>
        <button type="button" class="peek-btn" data-zoom-close>閉じる <kbd class="hidden md:inline">Esc</kbd></button>
      </div>
      <div id="zoom-body" class="zoom-body"></div>
    </dialog>
    <dialog id="peek" class="peek" aria-labelledby="peek-title">
      <div class="peek-top">
        <nav aria-label="たどった参照"><ol id="peek-crumbs" class="crumbs"></ol></nav>
        <p id="peek-live" class="sr-only" aria-live="polite"></p>
        <button type="button" id="peek-back" class="peek-btn" hidden>‹ 戻る</button>
        <button type="button" class="peek-btn" data-peek-close>閉じる <kbd class="hidden md:inline">Esc</kbd></button>
      </div>
      <div id="peek-strips" class="peek-strips"></div>
      <div id="peek-body"></div>
    </dialog>
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
